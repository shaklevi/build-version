pipeline {
    agent any
    
    triggers {
        GenericTrigger(
            token: 'shahar_private_token',
            genericVariables: [
                [key: 'PR_ACTION',     value: '$.action', defaultValue: ''],
                [key: 'PR_MERGED',     value: '$.pull_request.merged', defaultValue: 'false'],
                [key: 'sourceBranch', value: '$.pull_request.head.ref'],
                [key: 'targetBranch', value: '$.pull_request.base.ref'],
                [key: 'PR_REPO_URL',  value: '$.repository.html_url']
            ],
            
             // Extract the Bitbucket Event Key from the incoming HTTP Headers
            genericHeaderVariables: [
                [key: 'X-GitHub-Event', regexp: '^(.*)$', variable: 'x_event_key']
            ],
            
            // Filter: Only fire the pipeline if the event header equals pullrequest:fulfilled (Merged)
            regexpFilterText: '$PR_ACTION_$PR_MERGED',
            regexpFilterExpression: '^closed_true$',
             
            causeString: 'Triggered by GitHUB  PR Merge',
            printContributedVariables: true,
            printPostContent: true 
        )
    }
    environment {
        // Map the webhook injected variables safely using string interpolation
        START_TIME = "${currentBuild.startTimeInMillis}"
        SOURCE_BRANCH = "${sourceBranch}"
        TARGET_BRANCH = "${targetBranch}"
        REPO_URL      = "${PR_REPO_URL}"
    } 
    stages {
        stage('Build & Test') {
            steps {
                script {
                    // Safe access using the global env map
                    if (env.SOURCE_BRANCH) {
                        echo "=========================================="
                        echo "PR Action:     ${env.PR_ACTION}"
                        echo "PR Merged:     ${env.PR_MERGED}"
                        echo "Source Branch (Requesting to merge): ${env.SOURCE_BRANCH}"
                        echo "Target Branch (Merged into): ${env.TARGET_BRANCH}"
                        echo "Repo URL:      ${env.PR_REPO_URL}"
                        echo "=========================================="
                        if (env.SOURCE_BRANCH == 'Branch-A') {
                            echo "Source branch is Branch-A. Triggering Build-A..."
                            
                            
                            //Passing SOURCE_BRANCH=Branch-A  and REPO_URL as env variables to Build-A
                            build job: 'Build-A-GIT', parameters: [
                                string(name: 'SOURCE_BRANCH', value: env.SOURCE_BRANCH),
                                string(name: 'PR_REPO_URL', value: env.PR_REPO_URL),
                                string(name: 'START_TIME', value: env.START_TIME)
                            ]  
                        } else {
                            echo "Source branch is ${env.SOURCE_BRANCH}. Triggering Build-B..."
                            
                            
                            //Passing SOURCE_BRANCH=Branch-B  and REPO_URL as env variables to Build-B
                            build job: 'Build-B-GIT', parameters: [
                                string(name: 'SOURCE_BRANCH', value: env.SOURCE_BRANCH),
                                string(name: 'PR_REPO_URL', value: env.PR_REPO_URL),
                                string(name: 'START_TIME', value: env.START_TIME)
                            ]
                        }
                        
                    } else {
                        echo "Build triggered manually or payload structure mismatched."
                    }
                }
            }
        }
        stage('build') {
            steps {
                echo "Hello World!"
            }
        }
    }
}
