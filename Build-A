import groovy.json.JsonOutput

pipeline {
    agent any

    environment {
        FOLDER_NAME = 'clone_dir'
    }

    parameters {
        string(name: 'SOURCE_BRANCH', defaultValue: '', description: 'Branch passed from upstream')
        string(name: 'PR_REPO_URL', defaultValue: '', description: 'Repository URL passed from upstream')
        string(name: 'START_TIME', defaultValue: '', description: 'Start time of triggering build in millis')
    }

    stages {
        stage('Print Environment Details') {
            steps {
                echo "=============================================="
                echo "Received Source Branch: ${params.SOURCE_BRANCH}"
                echo "Received Repository URL: ${params.PR_REPO_URL}"
                echo "=============================================="
            }
        }

        stage('Clone Repository') {
            steps {
                script {
                    if (!params.SOURCE_BRANCH || !params.PR_REPO_URL) {
                        error "Missing required trigger environment variables: SOURCE_BRANCH or PR_REPO_URL."
                    }
                }
                dir("${env.FOLDER_NAME}") {
                    deleteDir()
                    echo "Cloning branch ${params.SOURCE_BRANCH} from ${params.PR_REPO_URL}..."
                    git branch: params.SOURCE_BRANCH, url: params.PR_REPO_URL
                }
            }
        }

        stage('Build') {
            steps {
                dir("${env.FOLDER_NAME}") {
                    sh '''
                        gcc --version
                        make
                    '''
                    script {
                        env.FILE_COUNT = sh(
                            script: "find . -not -path '*/.*' -type f | wc -l",
                            returnStdout: true
                        ).trim()

                        echo "=============================================="
                        echo "Total number of files in ${env.FOLDER_NAME}: ${env.FILE_COUNT}"
                        echo "=============================================="
                    }
                }
            }
        }
    }

    post {
        success {
            dir("${env.FOLDER_NAME}") {
                sshagent(credentials: ['git_ssh_key']) {
                    sh """
                        git config user.name "Jenkins CI"
                        git config user.email "jenkins@example.com"

                        echo "Build ${BUILD_NUMBER}" > version.txt

                        git add version.txt
                        git commit -m "chore: update version from build ${BUILD_NUMBER}" || echo "No changes to commit"
                        git push origin HEAD:${params.SOURCE_BRANCH}
                    """
                }
            }

            script {
                // Fallback to Jenkins' built-in build start time if START_TIME parameter is empty
                long start = params.START_TIME?.isLong() ? (params.START_TIME as Long) : currentBuild.startTimeInMillis
                long end = System.currentTimeMillis()
                long duration = end - start

                def startDate = new Date(start).format('yyyy-MM-dd HH:mm:ss z', TimeZone.getTimeZone('UTC'))
                def endDate = new Date(end).format('yyyy-MM-dd HH:mm:ss z', TimeZone.getTimeZone('UTC'))

                echo "======================================"
                echo "Build Start Time: ${startDate}"
                echo "Build End Time: ${endDate}"
                echo "Total Duration: ${duration / 1000.0} seconds"
                echo "======================================"

                def configData = [
                    "File Count": env.FILE_COUNT,
                    "Start Date": startDate,
                    "End Date": endDate
                ]

                def prettyJson = JsonOutput.prettyPrint(JsonOutput.toJson(configData))

                writeFile(file: 'build-params.json', text: prettyJson)
                sh 'cat build-params.json'

                bitbucketStatusNotify(buildState: 'SUCCESSFUL')
            }
        }

        failure {
            echo "Build failed. Skipping JSON generation to prevent corrupted data."
            bitbucketStatusNotify(buildState: 'FAILED')
        }
    }
}
