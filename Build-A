import groovy.json.JsonOutput

pipeline {
    agent any

    environment {
        FOLDER_NAME = 'clone_dir'
    }

    parameters {
        string(name: 'TARGET_REPO_OWNER', defaultValue: '', description:'Target repository owner')
        string(name: 'TARGET_REPO_NAME', defaultValue: '', description:'Target repository name')
        string(name: 'PR_COMMIT_SHA', defaultValue: '', description:'PR commit SHA')
        string(name: 'SOURCE_BRANCH', defaultValue: '', description: 'Branch passed from upstream')
        string(name: 'PR_REPO_URL', defaultValue: '', description: 'Repository URL passed from upstream')
        string(name: 'START_TIME', defaultValue: '', description: 'Start time of triggering build in millis')
    }

    stages {
        stage('Print Environment Details') {
            steps {
                echo "=============================================="
                echo "Received Source Branch: ${params.SOURCE_BRANCH}"
                echo "Received Repository URL: ${params.PR_REPO_URL}"
                echo "=============================================="
            }
        }

        stage('Clone Repository') {
            steps {
                script {
                    if (!params.SOURCE_BRANCH || !params.PR_REPO_URL) {
                        error "Missing required trigger environment variables: SOURCE_BRANCH or PR_REPO_URL."
                    }
                }
                dir("${env.FOLDER_NAME}") {
                    deleteDir()
                    echo "Cloning branch ${params.SOURCE_BRANCH} from ${params.PR_REPO_URL}..."
                    git branch: params.SOURCE_BRANCH, url: params.PR_REPO_URL
                }
            }
        }

        stage('Build') {
            steps {
                dir("${env.FOLDER_NAME}") {
                        script {
                            env.FILE_COUNT_SOURCE_BRANCH = sh(
                                script: "find . -not -path '*/.*' -type f | wc -l",
                                returnStdout: true
                            ).trim()

                            echo "=============================================="
                            echo "Total number of files in ${env.FOLDER_NAME}: ${env.FILE_COUNT_SOURCE_BRANCH}"
                            echo "=============================================="
                        }
                        sshagent(credentials: ['git_ssh_key']) {
                        sh '''
                            #  Checkout branch main
                            GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=no" git fetch origin main
                            git checkout -B main origin/main
                            
                            gcc --version
                            make
                        '''
                    }
                }
            }
        }
    }
    post {
            success {
                dir("${env.FOLDER_NAME}") {
                    sshagent(credentials: ['git_ssh_key']) {
                        sh """
                            git config user.name "Jenkins CI"
                            git config user.email "jenkins@example.com"

                            echo "Build ${BUILD_NUMBER}" > version.txt

                            git add .
                            git commit -m "chore: update version from build ${BUILD_NUMBER}" || echo "No changes to commit"
                            git remote set-url origin git@github.com:shaklevi/multi-file-c.git
                            GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=no" git push origin HEAD:main
                        """
                    }
                    script {
                                env.FILE_COUNT_TARGET_BRANCH = sh(
                                    script: "find . -not -path '*/.*' -type f | wc -l",
                                    returnStdout: true
                                ).trim()
                    }
                }

                echo "=============================================="
                echo "Total number of files in ${env.FOLDER_NAME}: ${env.FILE_COUNT_TARGET_BRANCH}"
                echo "=============================================="

                script {
                // Fallback to Jenkins' built-in build start time if START_TIME parameter is empty
                long start = params.START_TIME?.isLong() ? (params.START_TIME as Long) : currentBuild.startTimeInMillis
                long end = System.currentTimeMillis()
                long duration = end - start

                def startDate = new Date(start).format('yyyy-MM-dd HH:mm:ss z', TimeZone.getTimeZone('UTC'))
                def endDate = new Date(end).format('yyyy-MM-dd HH:mm:ss z', TimeZone.getTimeZone('UTC'))

                echo "======================================"
                echo "Build Start Time: ${startDate}"
                echo "Build End Time: ${endDate}"
                echo "Total Duration: ${duration / 1000.0} seconds"
                echo "======================================"

                def configData = [
                    "File Count Source": env.FILE_COUNT_SOURCE_BRANCH,
                    "File Count Target": env.FILE_COUNT_TARGET_BRANCH,
                    "Start Date": startDate,
                    "End Date": endDate
                ]

                def prettyJson = JsonOutput.prettyPrint(JsonOutput.toJson(configData))

                writeFile(file: 'build-params.json', text: prettyJson)
                sh 'cat build-params.json'

                }
            }

            failure {
                echo "Build failed. Skipping JSON generation to prevent corrupted data."
            }
            always {
                script {
                    def status = currentBuild.currentResult == 'SUCCESS' ? 'success' : 'failure'

                    if (params.TARGET_REPO_OWNER && params.TARGET_REPO_NAME && params.PR_COMMIT_SHA) {
                        withCredentials([string(credentialsId: 'github_creds', variable: 'GITHUB_TOKEN')]) {
                            sh """
                                curl -s -X POST \
                                -H "Authorization: token \${GITHUB_TOKEN}" \
                                -H "Accept: application/vnd.github.v3+json" \
                                https://github.com{params.TARGET_REPO_OWNER}/${params.TARGET_REPO_NAME}/statuses/${params.PR_COMMIT_SHA} \
                                -d '{"state":"${status}","context":"ci/cross-repo-jenkins","description":"Build finished with status: ${status}"}'
                            """
                        }
                    } else {
                        echo "Skipping GitHub status notification: Missing webhook PR variables (likely a manual build)."
                    }
                }
            }
        }
    }

